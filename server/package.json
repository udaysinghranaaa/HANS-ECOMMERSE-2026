{
  "name": "hans-solar-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "stop": "node scripts/stop-server.js",
    "restart": "node scripts/stop-server.js && node src/server.js",
    "upload:static-assets": "node scripts/upload-static-assets.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
