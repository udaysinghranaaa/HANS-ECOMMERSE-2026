NODE_ENV=development
PORT=5000
# Used by Prisma (datasource) and the server database connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hans_solar?retryWrites=true&w=majority
JWT_SECRET=your_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Production: comma-separated allowed frontend origins for CORS
# CLIENT_URL=https://store.hanssolar.in,https://hans-ecommerse-2026.vercel.app
SERVER_URL=http://localhost:5000
# Production example:
# SERVER_URL=https://hans-ecommerse-2026.onrender.com
ADMIN_NAME=Akash Rana
ADMIN_EMAIL=hanssolarenergy@gmail.com
ADMIN_PASSWORD=your_admin_password
# Product Environment API key pair from Cloudinary Console (Settings -> API Keys).
# The key must include Upload/create permission or uploads will return HTTP 403.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=hans-solar
